# Development only. Copy locally to .env; never commit filled values.
PORT=3001
NODE_ENV=development
STORE_DRIVER=file
LOCAL_DATA_PATH=.data/checkout.json
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
SESSION_SECRET=

# Use a matching sandbox URL and key family. Never use production keys.
PAYMENT_API_URL=https://api-sandbox.co.uat.wompi.dev/v1
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_INTEGRITY_SECRET=
PAYMENT_EVENTS_SECRET=

# AWS deployment: STORE_DRIVER=dynamodb; set a random SESSION_SECRET >=32 chars.
AWS_REGION=us-east-1
DYNAMODB_TABLE=lumen-checkout
# Optional SSM SecureString JSON loader used by the Lambda entrypoint.
PAYMENT_SECRET_PARAMETER=
